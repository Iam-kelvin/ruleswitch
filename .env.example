# Public client-side build configuration. These values are optional; leave them
# empty to keep analytics/crash uploads disabled. They are embedded in web/APK
# bundles and must never contain private server credentials.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=

# EAS-only secrets for a future Sentry source-map upload integration. These are
# not read by the app or the Coolify container. Never prefix them EXPO_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
