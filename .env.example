# Public client-side configuration. These values are optional for local/offline play.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=

# EAS-only secrets (Sentry source-map upload). Never prefix these with EXPO_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
