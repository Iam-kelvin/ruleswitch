{
  "expo": {
    "name": "RuleSwitch",
    "slug": "ruleswitch",
    "scheme": "ruleswitch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "android": {
      "package": "com.ruleswitch.game",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#11162A"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "RuleSwitch",
      "shortName": "RuleSwitch",
      "themeColor": "#11162A",
      "backgroundColor": "#11162A",
      "description": "A fast, fair game of attention and mental flexibility."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#11162A",
          "dark": {
            "backgroundColor": "#090C18"
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "SET_WITH_EAS_INIT"
      }
    }
  }
}
